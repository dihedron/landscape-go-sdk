package landscape

import (
	"context"
	"log/slog"
	"time"

	"github.com/dihedron/rawdata"
)

type Computer2Service struct {
	Service
}

type Computer2Result struct {
	Count    int        `json:"count,omitempy" yaml:"count,omitempy"`
	Results  []Computer `json:"results,omitempy" yaml:"results,omitempy"`
	Next     string     `json:"next,omitempy" yaml:"next,omitempy"`
	Previous any        `json:"previous,omitempy" yaml:"previous,omitempy"`
}

type Computer2 struct {
	ID                    int       `json:"id,omitempy" yaml:"id,omitempy"`
	Title                 string    `json:"title,omitempy" yaml:"title,omitempy"`
	Comment               string    `json:"comment,omitempy" yaml:"comment,omitempy"`
	Hostname              string    `json:"hostname,omitempy" yaml:"hostname,omitempy"`
	TotalMemory           int       `json:"total_memory,omitempy" yaml:"total_memory,omitempy"`
	TotalSwap             int       `json:"total_swap,omitempy" yaml:"total_swap,omitempy"`
	RebootRequiredFlag    bool      `json:"reboot_required_flag,omitempy" yaml:"reboot_required_flag,omitempy"`
	UpdateManagerPrompt   string    `json:"update_manager_prompt,omitempy" yaml:"update_manager_prompt,omitempy"`
	CloneID               any       `json:"clone_id,omitempy" yaml:"clone_id,omitempy"`
	LastExchangeTime      any       `json:"last_exchange_time,omitempy" yaml:"last_exchange_time,omitempy"`
	LastPingTime          time.Time `json:"last_ping_time,omitempy" yaml:"last_ping_time,omitempy"`
	Tags                  []string  `json:"tags,omitempy" yaml:"tags,omitempy"`
	AccessGroup           string    `json:"access_group,omitempy" yaml:"access_group,omitempy"`
	Distribution          string    `json:"distribution,omitempy" yaml:"distribution,omitempy"`
	CloudInstanceMetadata struct {
	} `json:"cloud_instance_metadata,omitempy" yaml:"cloud_instance_metadata,omitempy"`
	VMInfo        any   `json:"vm_info,omitempy" yaml:"vm_info,omitempy"`
	ContainerInfo any   `json:"container_info,omitempy" yaml:"container_info,omitempy"`
	UbuntuProInfo any   `json:"ubuntu_pro_info,omitempy" yaml:"ubuntu_pro_info,omitempy"`
	IsWslInstance bool  `json:"is_wsl_instance,omitempy" yaml:"is_wsl_instance,omitempy"`
	Children      []any `json:"children,omitempy" yaml:"children,omitempy"`
	Parent        any   `json:"parent,omitempy" yaml:"parent,omitempy"`
}

// UnmarshalFlag provides support for loading computer's data at the
// command line from a file on disk.
func (c *Computer2) UnmarshalFlag(value string) error {
	return rawdata.UnmarshalInto(value, c)
}

// Read reads information about a computer.
func (s *Computer2Service) Read(ctx context.Context, id string) (*Computer2, error) {
	//error := &Error{}
	response, err := s.client.
		R().
		SetContext(ctx).
		SetPathParam("id", id).
		SetQueryParam("options", "raw").
		SetResult(&ComputerResult{}).
		//SetResultError(error).
		Get("/computers/{id}")
	if err != nil {
		slog.Error("error reading computer", "id", id, "error", err, "result", response)
		return nil, err
	}
	return &(response.Result().(*ComputerResult).Results[0]), nil
}

